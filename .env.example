# Smart SOC Agent environment template.
# Keep real local values in .env; .env is intentionally git-ignored.

# Linux/RunPod agent host: Ollama, RAG server, and SmartSocAgent HTTP server.
# OLLAMA_BASE_URL must serve /api/generate.
OLLAMA_BASE_URL=https://<runpod-ollama-host>
OLLAMA_MODEL=qwen2.5:14b
OLLAMA_TEMPERATURE=0.2
OLLAMA_TIMEOUT=45
OLLAMA_NUM_PREDICT=512

# Internal smart-agent LLM backend.
# OLLAMA_BASE_URL also auto-enables Ollama, but this keeps runs explicit.
SMART_SOC_LLM_BACKEND=ollama

# Linux/RunPod agent host: call the local RAG HTTP server.
# Set SMART_SOC_RAG_BACKEND=qdrant only when the agent process opens data/rag/qdrant directly.
SOC_DEFENDER_RAG_URL=http://127.0.0.1:8765
SMART_SOC_RAG_BACKEND=http

# Windows benchmark client: SecRL calls the remote SmartSocAgent HTTP server.
# Windows does not need Ollama or RAG variables for remote-agent runs.
REMOTE_AGENT_URL=http://<linux-host>:8080
# REMOTE_AGENT_TOKEN=<token>

# Local fallback RAG uses Qdrant + SecureBERT with the manifest device cuda.
# Set SMART_SOC_RAG_BACKEND=keyword only for the lightweight fallback.
# SMART_SOC_RAG_BACKEND=qdrant

# Optional trace log for internal Ollama responses.
SOC_DEFENDER_LLM_LOG=trial_results/ollama_llm_trace.jsonl
